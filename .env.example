# --- Supabase (Postgres + Realtime + Storage + Auth) ---
# Project Settings > API on supabase.com (prefer region ca-central-1)
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="ey..."
SUPABASE_SERVICE_ROLE_KEY="ey..."

# App origin (absolute links, public API CORS later)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Postgres ---
# Runtime: Transaction pooler (port 6543) — used by src/lib/prisma.ts
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ca-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=20"
# Migrations DDL only: direct / session (port 5432) — used by prisma.config.ts
# NEVER run `prisma migrate` against the transaction pooler.
DIRECT_DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ca-central-1.pooler.supabase.com:5432/postgres"

# --- Agent webhook (Supabase Database Webhook → /api/agents/webhook) ---
AGENT_WEBHOOK_SECRET="change-me-local-only"

# --- Arsimatrix Agent Factory (recruitment → bati-recruit) ---
# Studio: C:/Users/Ntlechi/Arsimatrix → npm run dev → :3100
# ARSIMATRIX_ENABLED=true
# ARSIMATRIX_URL=http://127.0.0.1:3100
# ARSIMATRIX_BRIDGE_SECRET=
# RITMOKIT_CAREERS_SECRET=          # REQUIRED in production — protects applications/sync/triage
# ALLOW_OPEN_CAREERS=1           # local-only: open careers APIs when secret unset
# POST /api/careers/apply        # public intake
# POST /api/careers/sync         # re-push PENDING batch

# --- Punch PIN (kiosk) ---
# PUNCH_PIN_PEPPER=              # REQUIRED in production — scrypt pepper for employee PINs

# --- Field encryption (HR bank routing / account at rest) ---
# 32-byte key as 64 hex chars, e.g. openssl rand -hex 32
# RITMOKIT_FIELD_ENCRYPTION_KEY=    # REQUIRED in production


# --- Load test (local / staging only) ---
# ALLOW_LOAD_TEST="1"
# LOAD_TEST_SECRET="local-load-test-secret-min-16"

# --- Public website API (Phase 2d — Salsa Attitude) ---
# RITMOKIT_PUBLIC_ORIGINS="https://salsaattitude.com,https://www.salsaattitude.com,http://localhost:5173"
# RITMOKIT_PUBLIC_PAYMENT_PROVIDER="paypal"

# --- Compliance ---
TZ="America/Toronto"

# Production / staging matrix: see .env.production.template
