# ==============================================================================
# MIROK — Production / Staging environment matrix
# ==============================================================================
# Copy into Vercel Project Settings → Environment Variables (Production + Preview).
# Never commit real secrets. Staging must mirror Production keys with different
# values (separate Supabase project).
#
# Naming note: Prisma migrations use DIRECT_DATABASE_URL (see prisma.config.ts).
# Runtime app traffic uses DATABASE_URL (transaction pooler, port 6543).
# ==============================================================================

# ------------------------------------------------------------------------------
# APP URLS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://app.mirok.ca"
# Staging example: https://staging.mirok.ca  (or Vercel preview URL)

# ------------------------------------------------------------------------------
# SUPABASE AUTH + API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROD_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
# Service role — server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# ------------------------------------------------------------------------------
# DATABASE — SUPABASE POOLER (ca-central-1)
# ------------------------------------------------------------------------------
# Runtime (Next.js / PrismaPg adapter) — Transaction mode, port 6543.
# connection_limit caps concurrent clients per serverless instance during
# the 22h punch-out burst.
DATABASE_URL="postgresql://postgres.YOUR_PROD_REF:[PASSWORD]@aws-0-ca-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=20"

# Migrations / DDL only (prisma migrate deploy) — Session / direct, port 5432.
# NEVER point this at the transaction pooler.
DIRECT_DATABASE_URL="postgresql://postgres.YOUR_PROD_REF:[PASSWORD]@aws-0-ca-central-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# AGENT BUS SECURITY
# ------------------------------------------------------------------------------
# Shared bearer for Supabase Database Webhook → POST /api/agents/webhook
# Must match app.settings.agent_webhook_secret if using 0002_agent_webhook_autoconfig.sql
AGENT_WEBHOOK_SECRET="[GENERATE_WITH: openssl rand -hex 32]"

# --- Load test (STAGING ONLY — never enable on Production) ---
# ALLOW_LOAD_TEST="1"
# LOAD_TEST_SECRET="[GENERATE_WITH: openssl rand -hex 32]"

# Optional: force auth middleware in non-production (local smoke tests)
# AUTH_ENFORCE_DEV="1"

# ------------------------------------------------------------------------------
# COMPLIANCE PRESETS (Québec)
# ------------------------------------------------------------------------------
# Statutory timezone for CNESST windows, Pulse ISO weeks, payroll cutoffs.
TZ="America/Toronto"
# Default geofence for mobile punch (overridable per Location.geofenceRadiusMeters)
# NEXT_PUBLIC_GEOFENCE_RADIUS_METERS="150"

# ------------------------------------------------------------------------------
# POS / PAYROLL GATEWAYS (optional until connectors go live)
# ------------------------------------------------------------------------------
# Cluster POS webhook URL is derived from NEXT_PUBLIC_APP_URL + /api/pos/cluster/webhook
# Per-location secrets live in PosIntegration (DB), not here.
#
# Nethris / Payworks today export CSV from Mirok — no live API tokens required.
# Reserve these for future direct API connectors:
# NETHRIS_COMPANY_CODE=""
# PAYWORKS_API_TOKEN=""
